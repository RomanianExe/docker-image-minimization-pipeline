          "command_all": "RUN echo **** install runtime packages **** && apk add --no-cache alpine-release bash ca-certificates catatonit coreutils curl findutils jq netcat-openbsd procps-ng shadow tzdata && echo **** create abc user and make our folders **** && groupmod -g 1000 users && useradd -u 911 -U -d /config -s /bin/false abc && usermod -G users abc && mkdir -p /app /config /defaults /lsiopy && echo **** cleanup **** && rm -rf /tmp/*",
          "system_commands": [
            "echo **** install runtime packages ****",
            "apk add --no-cache alpine-release bash ca-certificates catatonit coreutils curl findutils jq netcat-openbsd procps-ng shadow tzdata",
            "echo **** create abc user and make our folders ****",
            "groupmod -g 1000 users",
