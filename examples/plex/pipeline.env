# ============================================================================
# OUT OF SCOPE for this project's results — BLOCKED BY docker-slim.
#
# The `original` stage passes and artifacts/plex/original/ holds a real
# baseline, but no validated slim image exists. Kept as evidence, not as
# pending work. Scope rationale: the plan's Stage 7 asks for "as many
# relevant examples as possible" and Stage 1 filters to those "that can be
# processed"; this entry has no Dockerfile, so it never enters Stage 2's
# `docker compose build` baseline. See docs/methodology.md 12.3.
#
# mint's artifact copier cannot handle the s6-overlay layout:
# "cloneDirPath() - os.MkdirAll(.../s6-overlay-helpers) error - file exists".
# mint exits code=-1. Not fixable from the pipeline side.
# ============================================================================

# Per-example pipeline configuration for the "plex" awesome-compose example.
#
# PREBUILT example (see docs/methodology.md §12). Single service, and the only
# entry in the set that asks for the host network namespace.
#
# An unclaimed Plex server still serves its HTTP API on 32400 — /identity is
# public and needs no token — so there is a real functional signal here even
# without a Plex account, which is what the test uses.
EXAMPLE=plex
COMPOSE_FILE=vendor/awesome-compose/plex/compose.yaml
COMPOSE_SERVICE=plex
PREBUILT_IMAGE=linuxserver/plex:latest
IMAGE_NAME=dip-plex
CONTAINER_PORT=32400
HOST_PORT=8119
HEALTH_PATH=/identity
HEALTH_EXPECT="machineIdentifier"
STARTUP_WAIT=45

EXTRA_PROBE_PATHS="/web/index.html"

APP_ENV="VERSION=docker PUID=1000 PGID=1000"

# linuxserver images build their runtime configuration under /config on first
# start (s6 init, generated Preferences.xml). Under compose that is a mount;
# docker-slim runs without one.
SLIM_MOUNTS="dip-slim-scratch-plex:/config"
# Paired with SLIM_MOUNTS above: mint's --exclude-mounts does not actually
# keep a mounted volume's contents out of the output image (verified), so the
# same path is also excluded by pattern. Both the directory and its contents,
# because leftover empty directories carry the analysis run's ownership.
SLIM_EXCLUDE_PATTERNS="/config /config/* /config/**"

# linuxserver images boot through s6-overlay, whose supervision tree lives in
# /package and is spawned by path rather than exec'd from $PATH. Slim strips
# most of it, and the container then crashloops before the application is ever
# reached: "s6-overlay-suexec: fatal: unable to spawn
# /package/admin/s6-overlay-3.2.1.0/libexec/preinit: No such file or directory".
# Kept wholesale — it is the init system, not application surface.
SLIM_INCLUDE_PATHS="/package /command /etc/s6-overlay /init"
