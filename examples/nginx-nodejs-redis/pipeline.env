# Per-example pipeline configuration for the "nginx-nodejs-redis"
# awesome-compose example. Only the "web" app image is built/minimized;
# "redis" is started from compose as an unmodified dependency and "nginx"
# (vendor-config load balancer) is out of scope. compose.yaml runs TWO
# replicas of this same image (web1/web2) behind nginx's upstream load
# balancer — that load-balancing behavior is unmodified nginx machinery, not
# something Slim touches or this pipeline minimizes, so only web1 is started
# (consistent with the traefik-golang scope decision); the app image itself is
# tested standalone, same as every other backend-only example.
EXAMPLE=nginx-nodejs-redis
COMPOSE_FILE=vendor/awesome-compose/nginx-nodejs-redis/compose.yaml
COMPOSE_SERVICE=web1
IMAGE_NAME=dip-nginx-nodejs-redis
CONTAINER_PORT=5000
HOST_PORT=8106
HEALTH_PATH=/
HEALTH_EXPECT="Number of visits is"
STARTUP_WAIT=5
# web1 declares no depends_on redis, so the dependency has to be named here.
COMPOSE_DEPS="redis"

# PATCHED (pipeline-side, no vendor files modified): web/.npmrc sets
# ignore-scripts=true, which npm also applies to `npm start` itself — the
# Dockerfile's CMD ["npm","start"] silently does nothing (confirmed via
# `npm start --loglevel=verbose`: "ignored because ignore-scripts is set to
# true"; exits 0 with zero output). compose.override.yaml sets the real
# entrypoint as the service `command:` for the functional-test runs;
# RUN_COMMAND restates it for pipeline/slim.sh, which runs outside compose and
# bakes it into the minimized image (--new-cmd). The application code itself
# is unaffected and correct, only npm's own script-running was blocked.
RUN_COMMAND="node server.js"
