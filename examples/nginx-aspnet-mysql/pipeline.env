# Per-example pipeline configuration for the "nginx-aspnet-mysql"
# awesome-compose example. Only "backend" (.NET) is built/minimized;
# "proxy" (custom-built but unmodified nginx:1.13-alpine + static conf) and
# "db" (mariadb) are started from compose unmodified.
EXAMPLE=nginx-aspnet-mysql
COMPOSE_FILE=vendor/awesome-compose/nginx-aspnet-mysql/compose.yaml
COMPOSE_SERVICE=backend
IMAGE_NAME=dip-nginx-aspnet-mysql
CONTAINER_PORT=8000
HOST_PORT=8104
HEALTH_PATH=/
HEALTH_EXPECT="Blog post"
STARTUP_WAIT=30
COMPOSE_DEPS="db proxy"
# `proxy` is built from the example's own proxy/Dockerfile rather than pulled.
COMPOSE_BUILD_DEPS="proxy"
PROXY_HOST_PORT=8105
# Slim probes the backend directly; only the database is needed for it.
COMPOSE_SLIM_DEPS="db"

# Program.cs's Prepare() opens its own MySQL connection synchronously at
# startup (top-level statements, before app.Run()) with NO retry loop — same
# fail-fast risk as react-java-mysql. compose.yaml handles this itself for the
# functional-test runs (`restart: always` plus `depends_on: db: condition:
# service_healthy`, so the backend is not started until mariadb reports
# healthy). pipeline/slim.sh gets no such gate — docker-slim starts its own
# container with no restart passthrough — so it waits STARTUP_WAIT for the
# dependency first; mariadb's cold start here is slower than
# react-java-mysql's, hence 30s.
#
# Slim-only: compose supplies both of these to the service already.
APP_ENV="ASPNETCORE_URLS=http://+:8000"
APP_MOUNT="vendor/awesome-compose/nginx-aspnet-mysql/db/password.txt:/run/secrets/db-password:ro"
