# Per-example pipeline configuration for the "react-rust-postgres"
# awesome-compose example. Only "backend" (actix-web, Rust) is built and
# minimized; "frontend" (CRA dev server) is out of scope and never started,
# "db" (postgres) is started from compose as an unmodified dependency.
#
# This is the only Rust example in the set, and the only one whose minimized
# target is a single statically-laid-out release binary on a bare debian-slim
# rather than an interpreted app plus its runtime.
EXAMPLE=react-rust-postgres
COMPOSE_FILE=vendor/awesome-compose/react-rust-postgres/compose.yaml
COMPOSE_SERVICE=backend
IMAGE_NAME=dip-react-rust-postgres
CONTAINER_PORT=8000
HOST_PORT=8108
HEALTH_PATH=/users
HEALTH_EXPECT="["
STARTUP_WAIT=15
COMPOSE_DEPS="db"
COMPOSE_NETWORK=server-side

# Slim-only: compose.yaml supplies all of these to the service itself via its
# `environment:` block; they are restated here because docker-slim starts its
# analysis container outside compose. ADDRESS matters as much as the PG_* set
# — main.rs defaults to 127.0.0.1:8000 when it is unset, which would bind
# loopback-only inside the container and make Slim's HTTP probe fail even
# though the process started fine.
APP_ENV="ADDRESS=0.0.0.0:8000 PG_HOST=db PG_DBNAME=postgres PG_USER=postgres PG_PASSWORD=mysecretpassword"
