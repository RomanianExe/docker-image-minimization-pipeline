# Per-example pipeline configuration for the "angular" awesome-compose
# example. Single service, `ng serve` dev server (Angular CLI JIT compiles
# and serves on every request — not a pre-built static bundle like
# react-nginx), so the full Angular CLI + node_modules tree is needed at
# runtime, not just build time.
EXAMPLE=angular
COMPOSE_FILE=vendor/awesome-compose/angular/compose.yaml
COMPOSE_SERVICE=web
IMAGE_NAME=dip-angular
CONTAINER_PORT=4200
HOST_PORT=8092
HEALTH_PATH=/
HEALTH_EXPECT="Angular"
STARTUP_WAIT=8
