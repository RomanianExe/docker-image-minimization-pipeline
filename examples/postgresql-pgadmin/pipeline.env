# ============================================================================
# OUT OF SCOPE for this project's results — BLOCKED BY docker-slim.
#
# The `original` stage passes and artifacts/postgresql-pgadmin/original/ holds a real
# baseline, but no validated slim image exists. Kept as evidence, not as
# pending work. Scope rationale: the plan's Stage 7 asks for "as many
# relevant examples as possible" and Stage 1 filters to those "that can be
# processed"; this entry has no Dockerfile, so it never enters Stage 2's
# `docker compose build` baseline. See docs/methodology.md 12.3.
#
# pgAdmin's entrypoint elevates through sudo, which mint's analysis
# container makes impossible ("sudo: effective uid is not 0 ... nosuid"). The
# container dies and mint exits code=-1. Not fixable from the pipeline side.
# ============================================================================

# Per-example pipeline configuration for the "postgresql-pgadmin"
# awesome-compose example.
#
# PREBUILT example: no Dockerfile in the entry, so PREBUILT_IMAGE names the
# registry reference the vendor compose file gives the target service and
# pipeline/build.sh pulls and re-tags it instead of building. See
# docs/methodology.md §12.
#
# Target choice: pgadmin. postgres is the other service, but a database server
# is the dependency in every other example in this repo, never the artifact
# being shipped; pgadmin is the application here.
#
# Note on scope: unlike every other multi-service example, the vendor compose
# file wires NOTHING between these two services — no servers.json, no
# environment pointing pgadmin at postgres. Out of the box pgadmin starts with
# an empty server list, so there is no cross-service round trip to assert here;
# the functional suite tests pgadmin's own stack (Flask app, internal SQLite
# config DB, static tree) instead. postgres is still started, because that is
# what the example declares.
EXAMPLE=postgresql-pgadmin
COMPOSE_FILE=vendor/awesome-compose/postgresql-pgadmin/compose.yaml
COMPOSE_SERVICE=pgadmin
PREBUILT_IMAGE=dpage/pgadmin4:latest
IMAGE_NAME=dip-postgresql-pgadmin
CONTAINER_PORT=80
HOST_PORT=8112
HEALTH_PATH=/login
HEALTH_EXPECT="pgAdmin"
STARTUP_WAIT=35
COMPOSE_DEPS="postgres"

EXTRA_PROBE_PATHS="/misc/ping /static/js/generated/style.css /static/img/logo-right-128.png"

# Slim-only: compose.yaml supplies these from the vendored .env; docker-slim
# starts its analysis container outside compose, so they are restated here.
APP_ENV="PGADMIN_DEFAULT_EMAIL=your@email.com PGADMIN_DEFAULT_PASSWORD=changeit"

# pgAdmin writes its config SQLite and session files under /var/lib/pgadmin.
# The vendor file declares no volume for it, but the same baking problem found
# on gitea applies: state created during Slim's analysed run would otherwise
# become part of the minimized image.
SLIM_MOUNTS="dip-slim-scratch-postgresql-pgadmin:/var/lib/pgadmin"
# Paired with SLIM_MOUNTS above: mint's --exclude-mounts does not actually
# keep a mounted volume's contents out of the output image (verified), so the
# same path is also excluded by pattern. Both the directory and its contents,
# because leftover empty directories carry the analysis run's ownership.
SLIM_EXCLUDE_PATTERNS="/var/lib/pgadmin /var/lib/pgadmin/* /var/lib/pgadmin/**"
