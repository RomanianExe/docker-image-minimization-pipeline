# Per-example pipeline configuration for the "nginx-wsgi-flask" awesome-compose
# example. Only "flask-app" is built/minimized; "nginx-proxy" (custom-built,
# templated config + response caching) is out of scope, so COMPOSE_DEPS is
# left unset and compose only ever starts flask-app.
EXAMPLE=nginx-wsgi-flask
COMPOSE_FILE=vendor/awesome-compose/nginx-wsgi-flask/compose.yaml
COMPOSE_SERVICE=flask-app
IMAGE_NAME=dip-nginx-wsgi-flask
CONTAINER_PORT=8000
HOST_PORT=8107
HEALTH_PATH=/flask-health-check
HEALTH_EXPECT="success"
STARTUP_WAIT=5

# PATCHED (pipeline-side, vendor files untouched): `RUN pip install
# --upgrade pip` is unpinned and resolves the current pip (26.0.1), whose
# own vendored toml parser throws IndexError reading markupsafe's
# pyproject.toml during an sdist build. compose.override.yaml substitutes
# examples/nginx-wsgi-flask/Dockerfile.patched, which pins pip to a
# known-good release; everything else is identical to the vendor Dockerfile.
# See docs/methodology.md for the original failure.

# The Dockerfile's own CMD ("python app.py") never actually starts a server —
# app.py has no `if __name__ == "__main__"` block at all (that logic lives in
# the unused wsgi.py). The real entrypoint only exists in compose.yaml's
# `command:`, which the functional-test runs now inherit directly from
# compose. RUN_COMMAND restates it for pipeline/slim.sh, which starts its own
# container outside compose and also bakes this into the minimized image
# (--new-cmd), so the slim image doesn't revert to the broken CMD.
RUN_COMMAND="gunicorn -w 3 -t 60 -b 0.0.0.0:8000 app:app"

# /cache-me exercised during Slim's dynamic analysis (nginx-side caching is
# out of scope here, only the backend response itself). /info is NOT probed
# here — its bracket-style request.headers[...] access 500s on a plain GET
# with no custom headers, and is instead verified directly in test.sh with
# realistic proxy-style headers (see functional-baseline.md); the underlying
# Werkzeug header-parsing machinery it depends on is already exercised by
# every other successful request regardless of route.
EXTRA_PROBE_PATHS="/cache-me"
