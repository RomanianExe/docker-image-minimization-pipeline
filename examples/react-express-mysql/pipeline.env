# Per-example pipeline configuration for the "react-express-mysql"
# awesome-compose example. Only "backend" is built/minimized; "frontend" (CRA
# dev server) is out of scope and never started, "db" is started from compose
# as an unmodified dependency.
EXAMPLE=react-express-mysql
COMPOSE_FILE=vendor/awesome-compose/react-express-mysql/compose.yaml
COMPOSE_SERVICE=backend
IMAGE_NAME=dip-react-express-mysql
CONTAINER_PORT=80
HOST_PORT=8102
HEALTH_PATH=/
HEALTH_EXPECT="Hello from MySQL"
STARTUP_WAIT=15
COMPOSE_DEPS="db"
COMPOSE_NETWORK=private

# /healthz is a second route (server.js) never hit by the default probe
# (HEALTH_PATH=/) — include it so Slim's dynamic analysis exercises it too.
EXTRA_PROBE_PATHS="/healthz"

# Distinct secrets pattern: DATABASE_PASSWORD holds a FILE PATH, not the
# password itself — config.js's readFileSync(process.env.DATABASE_PASSWORD)
# reads whatever path is given. Different mechanism from sparkjava-mysql/
# nginx-golang-mysql (which read a hardcoded path directly in code); here the
# app's own env var happens to point at the same Docker-secrets file.
#
# Slim-only: compose.yaml already supplies all four env vars and the
# db-password secret to the service; they are restated here because
# docker-slim starts its analysis container outside compose.
APP_ENV="DATABASE_HOST=db DATABASE_DB=example DATABASE_USER=root DATABASE_PASSWORD=/run/secrets/db-password"
APP_MOUNT="vendor/awesome-compose/react-express-mysql/db/password.txt:/run/secrets/db-password:ro"
