# Per-example pipeline configuration for the "nginx-golang-postgres"
# awesome-compose example. Near-identical to nginx-golang-mysql (same code
# structure, same Docker-secrets/proxy pattern) but with a postgres driver
# instead of mysql — kept for cluster-depth completeness, not expected to
# reveal a new pattern.
EXAMPLE=nginx-golang-postgres
COMPOSE_FILE=vendor/awesome-compose/nginx-golang-postgres/compose.yaml
COMPOSE_SERVICE=backend
IMAGE_NAME=dip-nginx-golang-postgres
CONTAINER_PORT=8000
HOST_PORT=8100
HEALTH_PATH=/
HEALTH_EXPECT="Blog post"
STARTUP_WAIT=20
COMPOSE_DEPS="db proxy"
PROXY_HOST_PORT=8101
# Slim probes the backend directly; only the database is needed for it.
COMPOSE_SLIM_DEPS="db"

# Slim-only: compose supplies the db-password secret to the service itself;
# docker-slim starts its analysis container outside compose, so the same file
# is bind-mounted for it explicitly.
APP_MOUNT="vendor/awesome-compose/nginx-golang-postgres/db/password.txt:/run/secrets/db-password:ro"
