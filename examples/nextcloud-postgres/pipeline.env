# ============================================================================
# OUT OF SCOPE for this project's results — UNVALIDATED FIX.
#
# The `original` stage passes and artifacts/nextcloud-postgres/original/ holds a real
# baseline, but no validated slim image exists. Kept as evidence, not as
# pending work. Scope rationale: the plan's Stage 7 asks for "as many
# relevant examples as possible" and Stage 1 filters to those "that can be
# processed"; this entry has no Dockerfile, so it never enters Stage 2's
# `docker compose build` baseline. See docs/methodology.md 12.3.
#
# Diagnosed: the slim image lost /usr/bin/rsync and then
# /upgrade.exclude, both used by the entrypoint to unpack the application. Both
# are now pinned below, but the confirming run was never completed.
# ============================================================================

# Per-example pipeline configuration for the "nextcloud-postgres"
# awesome-compose example.
#
# PREBUILT example: no Dockerfile in the entry, so PREBUILT_IMAGE names the
# registry reference the vendor compose file gives the target service and
# pipeline/build.sh pulls and re-tags it instead of building. See
# docs/methodology.md §12.
EXAMPLE=nextcloud-postgres
COMPOSE_FILE=vendor/awesome-compose/nextcloud-postgres/compose.yaml
COMPOSE_SERVICE=nc
PREBUILT_IMAGE=nextcloud:34.0.3-apache@sha256:b97df9e0e1ee3c8c6cc009cb3f12ddce915d624d543b3bb93882025fe323a407
IMAGE_NAME=dip-nextcloud-postgres
CONTAINER_PORT=80
HOST_PORT=8113
HEALTH_PATH=/index.php
HEALTH_EXPECT="Nextcloud"
STARTUP_WAIT=45
COMPOSE_DEPS="db"

EXTRA_PROBE_PATHS="/status.php /core/img/logo/logo.svg"

# Slim-only: compose.yaml supplies these to the service itself; docker-slim
# starts its analysis container outside compose, so they are restated here.
APP_ENV="POSTGRES_HOST=db POSTGRES_PASSWORD=nextcloud POSTGRES_DB=nextcloud POSTGRES_USER=nextcloud"

# The entrypoint unpacks /usr/src/nextcloud into /var/www/html on first start.
# Under compose that target is the nc_data volume (wiped between stages), but
# docker-slim runs without volumes, so the unpacked copy would be baked into
# the minified image — doubling it and making it a different image from the
# original. Same class of problem as gitea-postgres's app.ini.
SLIM_MOUNTS="dip-slim-scratch-nextcloud-postgres:/var/www/html"
# Paired with SLIM_MOUNTS above: mint's --exclude-mounts does not actually
# keep a mounted volume's contents out of the output image (verified), so the
# same path is also excluded by pattern. Both the directory and its contents,
# because leftover empty directories carry the analysis run's ownership.
SLIM_EXCLUDE_PATTERNS="/var/www/html /var/www/html/* /var/www/html/**"

# The entrypoint shells out to rsync exactly once, at startup, to unpack
# /usr/src/nextcloud into the web root. Slim's analysis observed that exec in
# one run and missed it in another with identical configuration, producing an
# image that crashlooped on "rsync: not found". Kept explicitly rather than
# left to the analysis.
SLIM_INCLUDE_BINS="/usr/bin/rsync"

# /upgrade.exclude is a plain data file the entrypoint hands to rsync
# (--exclude-from). Slim classified it as unused — it is read by rsync, never
# executed — and the container then crashloops on
# "failed to open exclude file /upgrade.exclude: No such file or directory".
# The same non-determinism as the rsync binary above: one of the two nextcloud
# runs kept it, the other did not.
SLIM_INCLUDE_PATHS="/upgrade.exclude"
