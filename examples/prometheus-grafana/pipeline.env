# Per-example pipeline configuration for the "prometheus-grafana"
# awesome-compose example.
#
# PREBUILT example: no Dockerfile in the entry, so PREBUILT_IMAGE names the
# registry reference the vendor compose file gives the target service and
# pipeline/build.sh pulls and re-tags it instead of building. See
# docs/methodology.md §12.
#
# Target choice: the entry has two equally "main" services. Grafana is the one
# minimized here — prometheus is a single static Go binary on a busybox-ish
# base, the same shape as traefik-golang and the nginx-golang-* backends, which
# the existing results already show Slim cannot improve (it grows them
# slightly). Grafana is a Go server plus a large JavaScript/asset tree, plus
# provisioning, so it is where minimization has something to remove.
EXAMPLE=prometheus-grafana
COMPOSE_FILE=vendor/awesome-compose/prometheus-grafana/compose.yaml
COMPOSE_SERVICE=grafana
PREBUILT_IMAGE=grafana/grafana:13.2.1@sha256:f772d434e8fab0049deb2b1b30abd43342bcfca1537614aa8d36080232cf4283
IMAGE_NAME=dip-prometheus-grafana
CONTAINER_PORT=3000
HOST_PORT=8111
HEALTH_PATH=/login
HEALTH_EXPECT="Grafana"
STARTUP_WAIT=20
COMPOSE_DEPS="prometheus"

EXTRA_PROBE_PATHS="/api/health /api/datasources /public/img/grafana_icon.svg"

# Slim-only: compose.yaml supplies these to the service itself; docker-slim
# starts its analysis container outside compose, so they are restated here.
APP_ENV="GF_SECURITY_ADMIN_USER=admin GF_SECURITY_ADMIN_PASSWORD=grafana"
