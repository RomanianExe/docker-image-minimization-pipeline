# Per-example pipeline configuration for the "react-express-mongodb"
# awesome-compose example. Only "backend" is built/minimized; "frontend"
# (React dev server) is out of scope and never started, "mongo" is started
# from compose as an unmodified dependency.
EXAMPLE=react-express-mongodb
COMPOSE_FILE=vendor/awesome-compose/react-express-mongodb/compose.yaml
COMPOSE_SERVICE=backend
IMAGE_NAME=dip-react-express-mongodb
CONTAINER_PORT=3000
HOST_PORT=8090
HEALTH_PATH=/api
HEALTH_EXPECT="Successfully completed"
STARTUP_WAIT=6
COMPOSE_DEPS="mongo"
COMPOSE_NETWORK=express-mongo

# config/config.json hardcodes MONGODB_URI=mongodb://mongo:27017/TodoApp, and
# there is no env override for it — the dependency must be reachable under
# exactly the hostname "mongo", which is what compose's own service name gives
# us for free here.

# db/index.js's app.emit("ready") only fires app.listen(3000) after Mongoose
# successfully connects (retried every 2s indefinitely) — same "real
# dependency" pattern as sparkjava-mysql, unlike aspnet-mssql where the DB was
# declared but never used.

# First occurrence of a POST-only code path: body-parser's JSON parsing lazily
# requires iconv-lite's "../encodings" module (found via a real failure — a
# GET-only Slim probe stripped it, breaking POST /api/todos while GET /api
# kept working fine). POST_PROBE_PATH/POST_PROBE_BODY make slim.sh exercise a
# real POST during dynamic analysis too, via --http-probe-cmd-file.
POST_PROBE_PATH=/api/todos
POST_PROBE_BODY='{"text":"slim-probe"}'
