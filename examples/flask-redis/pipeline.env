# Per-example pipeline configuration for the "flask-redis" awesome-compose example.
EXAMPLE=flask-redis
BUILD_CONTEXT=vendor/awesome-compose/flask-redis
DOCKERFILE_TARGET=builder
IMAGE_NAME=dip-flask-redis
CONTAINER_PORT=8000
HOST_PORT=8000
HEALTH_PATH=/
HEALTH_EXPECT="This webpage has been viewed"

# This example has one interconnected dependency service (redis) that must be
# running and reachable (by hostname alias "redis") for the app to function.
DEPENDENCY_IMAGE=redislabs/redismod
DEPENDENCY_ALIAS=redis
DEPENDENCY_CONTAINER=dip-flask-redis-dep-redis
