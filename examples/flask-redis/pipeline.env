# Per-example pipeline configuration for the "flask-redis" awesome-compose example.
EXAMPLE=flask-redis
COMPOSE_FILE=vendor/awesome-compose/flask-redis/compose.yaml
COMPOSE_SERVICE=web
IMAGE_NAME=dip-flask-redis
CONTAINER_PORT=8000
HOST_PORT=8000
HEALTH_PATH=/
HEALTH_EXPECT="This webpage has been viewed"

# One interconnected dependency service (redis) that must be running and
# reachable for the app to function. compose.yaml already declares
# `depends_on: redis`, so `up web` starts it either way; naming it in
# COMPOSE_DEPS keeps it explicit and lets pipeline/slim.sh start just the
# dependency without the app.
COMPOSE_DEPS="redis"
