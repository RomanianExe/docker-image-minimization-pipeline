# Per-example pipeline configuration for the "aspnet-mssql" awesome-compose example.
EXAMPLE=aspnet-mssql
COMPOSE_FILE=vendor/awesome-compose/aspnet-mssql/compose.yaml
COMPOSE_SERVICE=web
IMAGE_NAME=dip-aspnet-mssql
CONTAINER_PORT=80
HOST_PORT=8080
HEALTH_PATH=/
HEALTH_EXPECT="Application uses"
# .NET runtime startup is slower than the default 3s wait used for interpreted/static apps.
STARTUP_WAIT=4

# Extra routes/static assets to probe during Slim's dynamic analysis, so this
# multi-page MVC app's other pages and static files aren't stripped just because
# a single GET / never touches them.
EXTRA_PROBE_PATHS="/Home/About /Home/Contact /Home/Privacy /css/site.min.css /js/site.min.js"

# NOTE: unlike flask-redis, the `db` service in compose.yaml (azure-sql-edge) is
# never actually used by the application code (HomeController.cs is the stock
# ASP.NET MVC template with no DbContext/SQL calls) — confirmed by reading
# Startup.cs/HomeController.cs. `web` has no depends_on either, so COMPOSE_DEPS
# is left unset and only `web` is ever started.
