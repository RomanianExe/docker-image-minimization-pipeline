# Per-example pipeline configuration for the "spring-postgres" awesome-compose
# example. Only "backend" is built/minimized; "db" (postgres) is started from
# compose as an unmodified dependency, same treatment as sparkjava-mysql's mariadb.
EXAMPLE=spring-postgres
COMPOSE_FILE=vendor/awesome-compose/spring-postgres/compose.yaml
COMPOSE_SERVICE=backend
IMAGE_NAME=dip-spring-postgres
CONTAINER_PORT=8080
HOST_PORT=8091
HEALTH_PATH=/
HEALTH_EXPECT="Hello from Docker"
# compose.yaml declares no depends_on/healthcheck between backend and db, so
# this settle time still covers the JVM (Spring Boot) + postgres cold start,
# same order of magnitude as sparkjava-mysql's 25s.
STARTUP_WAIT=20
COMPOSE_DEPS="db"
# Both services sit on the example's own `spring-postgres` network rather than
# the default one; pipeline/slim.sh attaches its analysis container to it so
# the app can still resolve the "db" hostname.
COMPOSE_NETWORK=spring-postgres

# application.properties builds the JDBC URL as
# jdbc:postgresql://db:5432/${POSTGRES_DB} — POSTGRES_DB must be set in the
# app's own environment too (Spring property placeholder, no default given).
# compose.yaml sets it for the functional-test runs; restated here for
# pipeline/slim.sh's own container.
APP_ENV="POSTGRES_DB=example"

# Unlike sparkjava-mysql, the backend itself does NOT read the secret file —
# application.properties's spring.datasource.password falls back to a
# hardcoded default ("db-wrz2z") that happens to match db/password.txt's
# content, so no APP_MOUNT is needed here.
