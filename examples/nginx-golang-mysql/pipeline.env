# Per-example pipeline configuration for the "nginx-golang-mysql" awesome-compose
# example. Only "backend" is built/minimized; "proxy" (vendor nginx image,
# static conf) and "db" (mariadb) are started from compose unmodified.
EXAMPLE=nginx-golang-mysql
COMPOSE_FILE=vendor/awesome-compose/nginx-golang-mysql/compose.yaml
COMPOSE_SERVICE=backend
IMAGE_NAME=dip-nginx-golang-mysql
CONTAINER_PORT=8000
HOST_PORT=8098
HEALTH_PATH=/
HEALTH_EXPECT="Blog post"
STARTUP_WAIT=20
COMPOSE_DEPS="db proxy"
PROXY_HOST_PORT=8099
# Slim probes the backend directly; only the database is needed for it.
COMPOSE_SLIM_DEPS="db"

# main.go's connect() reads /run/secrets/db-password directly (same
# Docker-secrets pattern as sparkjava-mysql/nginx-flask-mysql), hardcoded
# host "db" — which compose's own service name provides. prepare() recreates
# and seeds the table BEFORE ListenAndServe, retrying DB connectivity for up
# to 60s; compose additionally gates the backend on db's healthcheck
# (depends_on: condition: service_healthy).
#
# Slim-only: restated because docker-slim starts its analysis container
# outside compose and so receives no compose secrets.
APP_MOUNT="vendor/awesome-compose/nginx-golang-mysql/db/password.txt:/run/secrets/db-password:ro"
