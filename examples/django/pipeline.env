# Per-example pipeline configuration for the "django" awesome-compose example.
EXAMPLE=django
COMPOSE_FILE=vendor/awesome-compose/django/compose.yaml
COMPOSE_SERVICE=web
IMAGE_NAME=dip-django
CONTAINER_PORT=8000
HOST_PORT=8083
# Determined by exploration: no root "/" view is registered in urls.py, so with
# DEBUG=True Django serves its own default "install worked" landing page there.
# /admin/login/ and its static CSS are the actually-functional part of the app
# (django.contrib.admin, staticfiles) — probed too so Slim doesn't strip them.
HEALTH_PATH=/
HEALTH_EXPECT="The install worked successfully"
EXTRA_PROBE_PATHS="/admin/login/ /static/admin/css/base.css"
