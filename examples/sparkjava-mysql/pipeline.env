# Per-example pipeline configuration for the "sparkjava-mysql" awesome-compose
# example. Only "backend" is built/minimized; "db" (mariadb) is started from
# compose as an unmodified dependency.
EXAMPLE=sparkjava-mysql
COMPOSE_FILE=vendor/awesome-compose/sparkjava-mysql/compose.yaml
COMPOSE_SERVICE=backend
IMAGE_NAME=dip-sparkjava-mysql
CONTAINER_PORT=8080
HOST_PORT=8087
HEALTH_PATH=/
HEALTH_EXPECT="Blog post"
# compose.yaml declares no depends_on and no healthcheck for db here, so the
# wait is still the app's own retry loop plus this settle time: mariadb cold
# start + up to 60s of connection retries need much longer than the JVM-only
# startup wait used for plain sparkjava (4s).
STARTUP_WAIT=25
COMPOSE_DEPS="db"

# Real DB dependency: App.java's main() calls prepare() (recreate table, seed 5
# rows) BEFORE port(8080) is called — if the DB is unreachable after 60 retries
# (1s apart), connect() throws and the app crashes before ever listening. So a
# successful GET / with the 5 seeded blog titles is a strong end-to-end signal
# (unlike aspnet-mssql, where the DB was declared but never actually used).

# Both the app and mariadb authenticate via a Docker-secrets file
# (compose.yaml's `secrets: db-password`), not a plain env var. compose
# provides it to both services for the functional-test runs; APP_MOUNT
# restates it for pipeline/slim.sh, whose container is started by docker-slim
# outside compose and therefore gets no compose secrets.
APP_MOUNT="vendor/awesome-compose/sparkjava-mysql/db/password.txt:/run/secrets/db-password:ro"
