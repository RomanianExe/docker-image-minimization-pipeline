# Per-example pipeline configuration for the "sparkjava-mysql" awesome-compose
# example. Only "backend" is built/minimized; "db" (mariadb) is a dependency,
# same treatment as flask-redis's redis / react-rust-postgres's postgres.
EXAMPLE=sparkjava-mysql
BUILD_CONTEXT=vendor/awesome-compose/sparkjava-mysql/backend
DOCKERFILE_TARGET=
IMAGE_NAME=dip-sparkjava-mysql
CONTAINER_PORT=8080
HOST_PORT=8087
HEALTH_PATH=/
HEALTH_EXPECT="Blog post"
# mariadb cold start + the app's own up-to-60s connection retry loop need much
# longer than the JVM-only startup wait used for plain sparkjava (4s).
STARTUP_WAIT=25

# Real DB dependency: App.java's main() calls prepare() (recreate table, seed 5
# rows) BEFORE port(8080) is called — if the DB is unreachable after 60 retries
# (1s apart), connect() throws and the app crashes before ever listening. So a
# successful GET / with the 5 seeded blog titles is a strong end-to-end signal
# (unlike aspnet-mssql, where the DB was declared but never actually used).
DEPENDENCY_IMAGE=mariadb:10.6.4-focal
DEPENDENCY_ALIAS=db
DEPENDENCY_CONTAINER=dip-sparkjava-mysql-dep-db
DEPENDENCY_ENV="MYSQL_DATABASE=example MYSQL_ROOT_PASSWORD_FILE=/run/secrets/db-password"

# Unlike every other DB-backed example so far, this app authenticates via a
# Docker-secrets-style file (compose.yaml's `secrets:`), not a plain env var:
# both the app and mariadb read the password from /run/secrets/db-password.
# New pipeline.env fields (DEPENDENCY_MOUNT / APP_MOUNT) bind-mount the same
# file into both containers; pipeline/deps.sh, pipeline/slim.sh, and
# pipeline/run-pipeline.sh were extended to support them.
DEPENDENCY_MOUNT="vendor/awesome-compose/sparkjava-mysql/db/password.txt:/run/secrets/db-password:ro"
APP_MOUNT="vendor/awesome-compose/sparkjava-mysql/db/password.txt:/run/secrets/db-password:ro"
