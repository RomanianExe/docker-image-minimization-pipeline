# Per-example pipeline configuration for the "nginx-golang" awesome-compose example.
# Only the "backend" service has a custom Dockerfile (build target); "proxy" is a
# prebuilt `nginx` image configured via a bind-mounted nginx.conf, so it is treated
# like flask-redis's `redis` dependency: started/stopped around the backend, not
# built/minimized itself.
EXAMPLE=nginx-golang
BUILD_CONTEXT=vendor/awesome-compose/nginx-golang/backend
DOCKERFILE_TARGET=builder
IMAGE_NAME=dip-nginx-golang-backend
CONTAINER_PORT=80
HOST_PORT=8081
HEALTH_PATH=/
HEALTH_EXPECT="Hello from Docker!"

# Reverse-proxy sidecar: prebuilt nginx image, config bind-mounted, proxying to
# the backend container by hostname alias "backend" (must match proxy/nginx.conf's
# `proxy_pass http://backend:80;`).
PROXY_IMAGE=nginx
PROXY_CONFIG=vendor/awesome-compose/nginx-golang/proxy/nginx.conf
PROXY_CONTAINER=dip-nginx-golang-proxy
PROXY_ALIAS=backend
PROXY_HOST_PORT=8080

# NOTE (docs/methodology.md "multi-stage caveat"): the Dockerfile has an unused
# smaller final stage (`FROM scratch` + the static binary) that compose does NOT
# build (it pins target: builder, the full golang:1.18-alpine dev image). This
# pipeline intentionally builds what compose actually builds (target=builder) as
# the "original" baseline, matching real-world behavior of this example as shipped,
# then documents the unused `scratch` stage separately as a "free" minimization
# opportunity in the comparison notes.
