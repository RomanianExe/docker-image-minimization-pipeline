# Per-example pipeline configuration for the "nginx-golang" awesome-compose example.
# Only the "backend" service has a custom Dockerfile; "proxy" is a prebuilt
# `nginx` image configured via a bind-mounted nginx.conf, started from compose
# alongside the backend but not built or minimized itself.
EXAMPLE=nginx-golang
COMPOSE_FILE=vendor/awesome-compose/nginx-golang/compose.yaml
COMPOSE_SERVICE=backend
IMAGE_NAME=dip-nginx-golang-backend
CONTAINER_PORT=80
HOST_PORT=8081
HEALTH_PATH=/
HEALTH_EXPECT="Hello from Docker!"

# Reverse-proxy sidecar: the vendor `proxy` service, verbatim (prebuilt nginx,
# vendor nginx.conf bind-mounted), reaching the app through the compose service
# name "backend" that proxy/nginx.conf's `proxy_pass http://backend:80;` expects.
COMPOSE_DEPS="proxy"
PROXY_HOST_PORT=8080
# Slim probes the backend directly, so the proxy is not started for it.
COMPOSE_SLIM_DEPS=""

# NOTE (docs/methodology.md "multi-stage caveat"): the Dockerfile has an unused
# smaller final stage (`FROM scratch` + the static binary) that compose does NOT
# build (it pins target: builder, the full golang:1.18-alpine dev image). Building
# through compose therefore produces exactly what this example ships as the
# "original" baseline, matching real-world behavior; the unused `scratch` stage is
# documented separately as a "free" minimization opportunity in the comparison notes.
