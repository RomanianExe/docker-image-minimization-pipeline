# ============================================================================
# OUT OF SCOPE for this project's results — UNVALIDATED FIX.
#
# The `original` stage passes and artifacts/pihole-cloudflared-DoH/original/ holds a real
# baseline, but no validated slim image exists. Kept as evidence, not as
# pending work. Scope rationale: the plan's Stage 7 asks for "as many
# relevant examples as possible" and Stage 1 filters to those "that can be
# processed"; this entry has no Dockerfile, so it never enters Stage 2's
# `docker compose build` baseline. See docs/methodology.md 12.3.
#
# Diagnosed: COMPOSE_NETWORK was missing (the example declares its
# own dns-net), so docker-slim could not join the network. Fixed below, but the
# confirming run was never completed.
# ============================================================================

# Per-example pipeline configuration for the "pihole-cloudflared-DoH"
# awesome-compose example.
#
# PREBUILT example (see docs/methodology.md §12). Pi-hole is a DNS server with
# a web admin UI, so unlike minecraft and wireguard it does have an HTTP
# surface for Slim to probe — but the probe only ever exercises the admin UI,
# never the DNS resolver, which is the half the example is actually about. The
# functional test covers both.
EXAMPLE=pihole-cloudflared-DoH
COMPOSE_FILE=vendor/awesome-compose/pihole-cloudflared-DoH/compose.yaml
COMPOSE_SERVICE=pihole
PREBUILT_IMAGE=pihole/pihole:2026.07.2@sha256:f7d1be836e3bc608b56d82fc9904f5a831cdfbc0dc9c6d58f94e4c985c70038b
IMAGE_NAME=dip-pihole-cloudflared-doh
CONTAINER_PORT=80
HOST_PORT=8118
# Pi-hole v6 redirects /admin/ to the login page; /admin/login is the first
# route that actually renders.
HEALTH_PATH=/admin/login
HEALTH_EXPECT="Pi-hole"
STARTUP_WAIT=45
COMPOSE_DEPS="cloudflared"

# The vendor file declares its own `dns-net` (with a fixed subnet, so the
# cloudflared sidecar can be addressed by IP), not the compose default.
COMPOSE_NETWORK=dns-net

EXTRA_PROBE_PATHS="/admin/style/themes/default-light.css /admin/img/logo.svg"

# Slim retained login.lp but removed the authenticated /admin/ route reached
# after Pi-hole redirects an already authenticated request. These are that
# route's direct server-side templates and static logo.
SLIM_INCLUDE_PATHS="/var/www/html/admin/index.lp /var/www/html/admin/scripts/lua/header_authenticated.lp /var/www/html/admin/scripts/lua/sidebar.lp /var/www/html/admin/scripts/lua/footer.lp /var/www/html/admin/img/logo-bw.svg"

# Mint drops the original image's empty /etc/pihole directory. FTL requires
# that root:root 0755 scaffold at normal startup to apply
# FTLCONF_webserver_api_password; it then writes all mutable state itself.
# The post-Mint wrapper adds only that empty directory, not any configuration.
SLIM_POST_MINT_DOCKERFILE="examples/pihole-cloudflared-DoH/Dockerfile.post-mint"

# Slim-only: compose.yaml supplies these from the vendored .env; docker-slim
# starts its analysis container outside compose. PIHOLE_DNS_ points at the
# cloudflared sidecar's fixed address on the example's own 172.20.0.0/24
# network, exactly as the vendor file writes it.
APP_ENV="TZ=Etc/UTC PIHOLE_DNS_=172.20.0.2#5054;1.1.1.1 FTLCONF_webserver_api_password=changeit"

# Pi-hole generates its configuration, gravity database and logs under
# /etc/pihole at first start.
SLIM_MOUNTS="dip-slim-scratch-pihole-cloudflared-doh:/etc/pihole"
# Paired with SLIM_MOUNTS above: mint's --exclude-mounts does not actually
# keep a mounted volume's contents out of the output image (verified), so the
# same path is also excluded by pattern. Both the directory and its contents,
# because leftover empty directories carry the analysis run's ownership.
SLIM_EXCLUDE_PATTERNS="/etc/pihole /etc/pihole/* /etc/pihole/**"
