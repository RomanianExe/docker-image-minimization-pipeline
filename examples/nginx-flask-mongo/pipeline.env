# Per-example pipeline configuration for the "nginx-flask-mongo" awesome-compose
# example. Only "backend" (Flask) is built/minimized; "web" (nginx reverse
# proxy) and "mongo" are started from compose unmodified.
EXAMPLE=nginx-flask-mongo
COMPOSE_FILE=vendor/awesome-compose/nginx-flask-mongo/compose.yaml
COMPOSE_SERVICE=backend
IMAGE_NAME=dip-nginx-flask-mongo
CONTAINER_PORT=9091
HOST_PORT=8094
HEALTH_PATH=/
HEALTH_EXPECT="Hello from the MongoDB client"
STARTUP_WAIT=5
# "web" is this example's nginx reverse proxy. Its config is a template
# (${FLASK_SERVER_ADDR}) rendered by `envsubst` in compose.yaml's own command
# override — running it through compose means the template is rendered exactly
# as upstream intends, with no pre-rendered copy to keep in sync.
COMPOSE_DEPS="mongo web"
PROXY_HOST_PORT=8095
# Slim probes the backend directly; only mongo is needed for it.
COMPOSE_SLIM_DEPS="mongo"

# server.py reads FLASK_SERVER_PORT (compose.yaml sets 9091); the client
# connects to a hardcoded "mongo:27017", same pattern as
# react-express-mongodb (no env override, so the dependency has to answer to
# exactly that hostname — which compose's service name provides).
#
# Slim-only: restated because docker-slim starts its container outside compose.
APP_ENV="FLASK_SERVER_PORT=9091"
