# Per-example pipeline configuration for the "fastapi" awesome-compose
# example. Single service. Base image is tiangolo's uvicorn-gunicorn-fastapi
# (python3.9-slim) rather than a plain python:slim base, and reads PORT from
# the environment to decide what to bind to (compose.yaml sets PORT=8000).
EXAMPLE=fastapi
COMPOSE_FILE=vendor/awesome-compose/fastapi/compose.yaml
COMPOSE_SERVICE=api
IMAGE_NAME=dip-fastapi
CONTAINER_PORT=8000
HOST_PORT=8089
HEALTH_PATH=/
HEALTH_EXPECT="OK"

# FastAPI auto-generates /openapi.json (schema introspection via Pydantic) and
# /docs (Swagger UI, separate static/template rendering path) beyond the one
# hand-written route in app/main.py. These exercise different framework code
# paths than a plain GET /, so they're added to Slim's dynamic-analysis probe
# too — otherwise Slim would only ever see "/" exercised and could strip
# modules that FastAPI's own machinery needs for these built-in endpoints.
EXTRA_PROBE_PATHS="/openapi.json /docs"

# Slim-only: pipeline/slim.sh starts its own container through docker-slim
# rather than through compose, so anything compose.yaml sets on the service
# has to be restated here for the dynamic-analysis run. compose.yaml's own
# `environment: PORT: 8000` covers the functional-test runs.
APP_ENV="PORT=8000"
