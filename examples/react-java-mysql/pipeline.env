# Per-example pipeline configuration for the "react-java-mysql" awesome-compose
# example. Only "backend" (Spring Boot) is built/minimized; "frontend" (CRA
# dev server) is out of scope and never started, "db" (mariadb) is started
# from compose as an unmodified dependency.
EXAMPLE=react-java-mysql
COMPOSE_FILE=vendor/awesome-compose/react-java-mysql/compose.yaml
COMPOSE_SERVICE=backend
IMAGE_NAME=dip-react-java-mysql
CONTAINER_PORT=8080
HOST_PORT=8103
HEALTH_PATH=/
HEALTH_EXPECT="Docker"
STARTUP_WAIT=20
COMPOSE_DEPS="db"
COMPOSE_NETWORK=spring-mysql

# Unlike sparkjava-mysql/nginx-golang-mysql (app-level connection-retry
# loops), Spring/HikariCP here fails fast and crashes on the first refused
# connection if mariadb isn't ready yet. compose.yaml handles this on its own
# for the functional-test runs — `restart: always` plus
# `depends_on: db: condition: service_healthy`, so compose does not even start
# the backend until mariadb's healthcheck passes. pipeline/slim.sh has no such
# guarantee (docker-slim starts its own container with no restart passthrough),
# so it waits STARTUP_WAIT for the dependency before invoking Slim.

# New Docker-secrets variant: a custom Spring EnvironmentPostProcessor
# (DockerSecretsProcessor, registered via META-INF/spring.factories) reads
# /run/secrets/db-password itself at startup and sets a system property that
# application.properties then interpolates (spring.datasource.password=
# ${MYSQL_PASSWORD:db-57xsl}) — unlike spring-postgres, which never actually
# read the file and just relied on a matching hardcoded default. This
# exercises custom framework-extension code, not just a property default.
#
# Slim-only: compose supplies MYSQL_HOST and the db-password secret to the
# service itself; both are restated here because docker-slim starts its
# analysis container outside compose.
APP_ENV="MYSQL_HOST=db"
APP_MOUNT="vendor/awesome-compose/react-java-mysql/db/password.txt:/run/secrets/db-password:ro"
