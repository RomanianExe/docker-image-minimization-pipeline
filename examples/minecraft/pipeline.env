# ============================================================================
# OUT OF SCOPE for this project's results — UNVALIDATED FIX.
#
# The `original` stage passes and artifacts/minecraft/original/ holds a real
# baseline, but no validated slim image exists. Kept as evidence, not as
# pending work. Scope rationale: the plan's Stage 7 asks for "as many
# relevant examples as possible" and Stage 1 filters to those "that can be
# processed"; this entry has no Dockerfile, so it never enters Stage 2's
# `docker compose build` baseline. See docs/methodology.md 12.3.
#
# Diagnosed: the slim-stage test used `docker exec test -f`, and the
# minimized image has no shell utilities. The assertion now reads the volume
# from the host, but the confirming run was never completed.
# ============================================================================

# Per-example pipeline configuration for the "minecraft" awesome-compose
# example.
#
# PREBUILT example (see docs/methodology.md §12), and the first entry in the
# whole set that speaks no HTTP at all: Minecraft's protocol is its own binary
# format on TCP 25565. Two consequences:
#
#   * SLIM_PROBE=none — there is nothing for docker-slim's HTTP prober to
#     drive, so instead of "continue when the probe finishes" Slim is told to
#     let the container run for SLIM_RUN_SECONDS and keep whatever that
#     exercised. That is a strictly weaker signal than a probed run: only the
#     code paths the server walks while starting up and idling are observed,
#     and nothing a connecting client would trigger.
#   * The functional test speaks the protocol with the server-list ping that
#     the image's own mc-monitor tool implements, rather than curl.
EXAMPLE=minecraft
COMPOSE_FILE=vendor/awesome-compose/minecraft/compose.yaml
COMPOSE_SERVICE=minecraft
PREBUILT_IMAGE=itzg/minecraft-server@sha256:d686c51f034dfd8f3a27436340eaad7baf5cb08a873a2d5edb3cbede7e737f9f
IMAGE_NAME=dip-minecraft
CONTAINER_PORT=25565
HOST_PORT=8117
STARTUP_WAIT=180
SLIM_PROBE=none
SLIM_RUN_SECONDS=300

# Slim-only: compose.yaml supplies EULA to the service itself; without it the
# server refuses to start and Slim would analyse a container that exits.
APP_ENV="EULA=TRUE"

# The server downloads its jar and generates a world under /data on first run.
# Under compose that is a volume; docker-slim runs without one, so the whole
# generated world would otherwise be baked into the minimized image.
SLIM_MOUNTS="dip-slim-scratch-minecraft:/data"
# Paired with SLIM_MOUNTS above: mint's --exclude-mounts does not actually
# keep a mounted volume's contents out of the output image (verified), so the
# same path is also excluded by pattern. Both the directory and its contents,
# because leftover empty directories carry the analysis run's ownership.
SLIM_EXCLUDE_PATTERNS="/data /data/* /data/**"
