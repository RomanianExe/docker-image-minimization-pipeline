# ============================================================================
# OUT OF SCOPE for this project's results — BLOCKED BY docker-slim.
#
# The `original` stage passes and artifacts/gitea-postgres/original/ holds a real
# baseline, but no validated slim image exists. Kept as evidence, not as
# pending work. Scope rationale: the plan's Stage 7 asks for "as many
# relevant examples as possible" and Stage 1 filters to those "that can be
# processed"; this entry has no Dockerfile, so it never enters Stage 2's
# `docker compose build` baseline. See docs/methodology.md 12.3.
#
# The minimized image is FUNCTIONAL — verified by starting it with
# --tmpfs /data, where the install completes and the API responds. What breaks
# it is the empty directory tree mint leaves under /data, which Docker then
# pre-populates into the named volume, after which gitea's init skips its own
# chown. See docs/methodology.md 12.6 for the full four-link chain and for why
# switching to tmpfs to make this pass was deliberately NOT done.
# ============================================================================

# Per-example pipeline configuration for the "gitea-postgres" awesome-compose
# example.
#
# PREBUILT example: no Dockerfile anywhere in the entry, so there is nothing to
# `docker compose build`. PREBUILT_IMAGE names the exact registry reference the
# vendor compose file gives the target service and pipeline/build.sh pulls and
# re-tags it as :original. See docs/methodology.md §12.
EXAMPLE=gitea-postgres
COMPOSE_FILE=vendor/awesome-compose/gitea-postgres/compose.yaml
COMPOSE_SERVICE=gitea
PREBUILT_IMAGE=gitea/gitea:latest
IMAGE_NAME=dip-gitea-postgres
CONTAINER_PORT=3000
HOST_PORT=8110
HEALTH_PATH=/
HEALTH_EXPECT="Gitea"
STARTUP_WAIT=20
COMPOSE_DEPS="db"

EXTRA_PROBE_PATHS="/api/healthz"

# Slim-only: compose.yaml supplies these to the service itself; docker-slim
# starts its analysis container outside compose, so they are restated here.
APP_ENV="DB_TYPE=postgres DB_HOST=db:5432 DB_NAME=gitea DB_USER=gitea DB_PASSWD=gitea"

# Gitea ships uninstalled: the first request serves a setup form, and nothing
# touches postgres until that form is submitted. A GET-only probe would
# therefore drive Slim's analysis through the installer page and NOTHING of the
# database, migration or template machinery that the example is actually about,
# and Slim would strip it. The probe submits the same install form the
# functional test does, so the analysed run covers schema creation and the
# post-install home page. The form is form-urlencoded, not JSON, hence
# POST_PROBE_CONTENT_TYPE.
POST_PROBE_PATH=/
POST_PROBE_CONTENT_TYPE=application/x-www-form-urlencoded
POST_PROBE_BODY='db_type=postgres&db_host=db%3A5432&db_user=gitea&db_passwd=gitea&db_name=gitea&db_schema=&ssl_mode=disable&app_name=DIP+Gitea&repo_root_path=%2Fdata%2Fgit%2Frepositories&lfs_root_path=%2Fdata%2Fgit%2Flfs&run_user=git&domain=localhost&ssh_port=22&http_port=3000&app_url=http%3A%2F%2Flocalhost%3A3000%2F&log_root_path=%2Fdata%2Fgitea%2Flog&password_algorithm=pbkdf2'

# Gitea keeps everything it writes under /data, which compose backs with the
# git_data volume (wiped between pipeline stages). docker-slim runs without
# that volume, so the install the probe performs would otherwise be baked into
# the minified image — the first run of this example produced a "slim" image
# that came up already installed, carrying a generated app.ini, and was
# therefore no longer the same image being compared. Excluding /data from the
# output image keeps the minimized image equivalent to the original while still
# letting the probe exercise the install code path. Both the file and the
# directory pattern are needed: leaving the directories behind reintroduces the
# problem in another form — gitea then failed with "open
# /data/git/.ssh/authorized_keys.tmp: permission denied", because the leftover
# directories carried the ownership of Slim's analysis run.
SLIM_MOUNTS="dip-slim-scratch-gitea-postgres:/data"
# Paired with SLIM_MOUNTS above: mint's --exclude-mounts does not actually
# keep a mounted volume's contents out of the output image (verified), so the
# same path is also excluded by pattern. Both the directory and its contents,
# because leftover empty directories carry the analysis run's ownership.
SLIM_EXCLUDE_PATTERNS="/data/* /data/**"
SLIM_INCLUDE_PATHS="/data"
