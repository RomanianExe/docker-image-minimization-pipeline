# ============================================================================
# OUT OF SCOPE for this project's results — UNVALIDATED FIX.
#
# The `original` stage passes and artifacts/wireguard/original/ holds a real
# baseline, but no validated slim image exists. Kept as evidence, not as
# pending work. Scope rationale: the plan's Stage 7 asks for "as many
# relevant examples as possible" and Stage 1 filters to those "that can be
# processed"; this entry has no Dockerfile, so it never enters Stage 2's
# `docker compose build` baseline. See docs/methodology.md 12.3.
#
# Diagnosed: Slim strips most of the s6-overlay tree and the
# container crashloops before the application starts. /package and friends are
# now pinned below, but the confirming run was never completed.
# ============================================================================

# Per-example pipeline configuration for the "wireguard" awesome-compose
# example.
#
# PREBUILT example (see docs/methodology.md §12). Like minecraft, it speaks no
# HTTP — it is a UDP VPN endpoint — so SLIM_PROBE=none applies and the analysed
# run covers only startup and idle, never a connecting peer. It also needs
# NET_ADMIN/SYS_MODULE and the host's kernel modules, all of which come from
# the vendor compose file unchanged.
EXAMPLE=wireguard
COMPOSE_FILE=vendor/awesome-compose/wireguard/compose.yaml
COMPOSE_SERVICE=wireguard
PREBUILT_IMAGE=linuxserver/wireguard:1.0.20260223-r0-ls121@sha256:bf03578ef7318ccc7675b4a82beac4d35cd0da2253194f6b6ecf61656b40f0ee
IMAGE_NAME=dip-wireguard
CONTAINER_PORT=51820
HOST_PORT=51820
STARTUP_WAIT=30
SLIM_PROBE=none
SLIM_RUN_SECONDS=90

APP_ENV="PUID=1000 PGID=1000 TZ=Etc/UTC SERVERURL=auto SERVERPORT=51820 PEERS=1 PEERDNS=auto INTERNAL_SUBNET=10.13.13.0 ALLOWEDIPS=0.0.0.0/0"
SLIM_MOUNTS="dip-slim-scratch-wireguard:/config"
# Paired with SLIM_MOUNTS above: mint's --exclude-mounts does not actually
# keep a mounted volume's contents out of the output image (verified), so the
# same path is also excluded by pattern. Both the directory and its contents,
# because leftover empty directories carry the analysis run's ownership.
SLIM_EXCLUDE_PATTERNS="/config /config/* /config/**"

# linuxserver images boot through s6-overlay, whose supervision tree lives in
# /package and is spawned by path rather than exec'd from $PATH. Slim strips
# most of it, and the container then crashloops before the application is ever
# reached: "s6-overlay-suexec: fatal: unable to spawn
# /package/admin/s6-overlay-3.2.1.0/libexec/preinit: No such file or directory".
# Kept wholesale — it is the init system, not application surface.
SLIM_INCLUDE_PATHS="/package /command /etc/s6-overlay /init"
