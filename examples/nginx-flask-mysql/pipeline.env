# Per-example pipeline configuration for the "nginx-flask-mysql" awesome-compose
# example. Only "backend" (Flask) is built/minimized; "proxy" (custom-built
# but unmodified nginx:1.13-alpine + static conf) and "db" (mariadb) are
# started from compose unmodified.
EXAMPLE=nginx-flask-mysql
COMPOSE_FILE=vendor/awesome-compose/nginx-flask-mysql/compose.yaml
COMPOSE_SERVICE=backend
IMAGE_NAME=dip-nginx-flask-mysql
CONTAINER_PORT=8000
HOST_PORT=8096
HEALTH_PATH=/
HEALTH_EXPECT="Hello"
STARTUP_WAIT=15
COMPOSE_DEPS="db proxy"
# `proxy` is built from the example's own proxy/Dockerfile rather than pulled,
# so it has to be built before the run stage's `up --no-build`.
COMPOSE_BUILD_DEPS="proxy"
PROXY_HOST_PORT=8097
# Slim probes the backend directly; only the database is needed for it.
COMPOSE_SLIM_DEPS="db"
# backend and db share the example's `backnet` network (the proxy sits on
# `frontnet`); pipeline/slim.sh attaches its analysis container to backnet so
# the app can resolve the "db" hostname.
COMPOSE_NETWORK=backnet

# PATCHED (pipeline-side, vendor files untouched): requirements.txt pins
# Flask==2.0.1 but not Werkzeug, and pip resolves current Werkzeug (3.1.8),
# which removed werkzeug.urls.url_quote — a name Flask 2.0.1 imports
# directly, crashing on startup. compose.override.yaml substitutes
# examples/nginx-flask-mysql/Dockerfile.patched, which adds a compatible
# Werkzeug pin; everything else is identical to the vendor Dockerfile. See
# docs/methodology.md for the original failure.

# hello.py's DBManager reads the DB password directly from
# /run/secrets/db-password (same Docker-secrets pattern as sparkjava-mysql),
# and defaults host="db" — both provided by compose. Slim-only restatement:
APP_MOUNT="vendor/awesome-compose/nginx-flask-mysql/db/password.txt:/run/secrets/db-password:ro"
