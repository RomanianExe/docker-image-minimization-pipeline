# syntax=docker/dockerfile:1.4
#
# PATCHED copy of vendor/awesome-compose/nginx-flask-mysql/backend/Dockerfile.
# Build context is still the vendor directory (COPY commands below resolve
# against it) — only this Dockerfile is substituted, via
# compose.override.yaml's build.dockerfile.
#
# The exact tested Python dependency graph is supplied from the project-owned
# named build context, leaving the vendor requirements.txt untouched.
FROM --platform=$BUILDPLATFORM python:3.10-alpine AS builder

WORKDIR /code
COPY requirements.txt /code
COPY --from=dip_locks requirements.lock /locks/requirements.lock
RUN --mount=type=cache,target=/root/.cache/pip \
    pip3 install --require-hashes -r /locks/requirements.lock

COPY . .

ENV FLASK_APP hello.py
ENV FLASK_ENV development
ENV FLASK_RUN_PORT 8000
ENV FLASK_RUN_HOST 0.0.0.0

EXPOSE 8000

CMD ["flask", "run"]

FROM builder AS dev-envs

RUN <<EOF
apk update
apk add git
EOF

RUN <<EOF
addgroup -S docker
adduser -S --shell /bin/bash --ingroup docker vscode
EOF

# install Docker tools (cli, buildx, compose)
COPY --from=gloursdocker/docker / /

CMD ["flask", "run"]
