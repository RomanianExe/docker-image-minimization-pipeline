# Per-example pipeline configuration for the "vuejs" awesome-compose example.
# Single service, `vue-cli-service serve` dev server (webpack-dev-server),
# same JIT-compiled-on-every-request pattern as `angular`, but Alpine base +
# yarn instead of Debian-slim + npm.
EXAMPLE=vuejs
COMPOSE_FILE=vendor/awesome-compose/vuejs/compose.yaml
COMPOSE_SERVICE=web
IMAGE_NAME=dip-vuejs
CONTAINER_PORT=8080
HOST_PORT=8093
# public/index.html's <title> is populated from package.json's "name"
# ("vuejs") by htmlWebpackPlugin — the actual "Welcome to Your Vue.js App"
# text only exists in the compiled JS bundle (client-side rendered), checked
# separately in tests/specific/vuejs/test.sh, same reasoning as `angular`.
HEALTH_PATH=/
HEALTH_EXPECT="vuejs"
STARTUP_WAIT=15

# PATCHED (pipeline-side, vendor files untouched): `yarn global add
# @vue/cli` is unpinned, fails against the live registry today, and turns
# out to be unnecessary anyway — package.json's "serve" script already
# resolves to the LOCAL, yarn.lock-pinned @vue/cli-service devDependency.
# compose.override.yaml substitutes examples/vuejs/Dockerfile.patched, which
# removes the unused/broken global install line; everything else is identical
# to the vendor Dockerfile. See docs/methodology.md for the full
# investigation (pinning the global install's version alone wasn't enough;
# bumping the base Node version broke the locked local dependency tree
# instead).
