# Per-example pipeline configuration for the "sparkjava" awesome-compose example.
EXAMPLE=sparkjava
BUILD_CONTEXT=vendor/awesome-compose/sparkjava/sparkjava
# DOCKERFILE_TARGET intentionally empty: as with react-nginx, the Dockerfile's
# final (unnamed) stage (eclipse-temurin:17-jre-focal running the built jar) is
# the one compose.yaml actually builds (no `target:` set there either).
DOCKERFILE_TARGET=
IMAGE_NAME=dip-sparkjava
CONTAINER_PORT=8080
HOST_PORT=8080
HEALTH_PATH=/
HEALTH_EXPECT="Hello from Docker!"
