# Per-example pipeline configuration for the "sparkjava" awesome-compose example.
# As with react-nginx, the Dockerfile's final (unnamed) stage
# (eclipse-temurin:17-jre-focal running the built jar) is the one compose.yaml
# actually builds.
EXAMPLE=sparkjava
COMPOSE_FILE=vendor/awesome-compose/sparkjava/compose.yaml
COMPOSE_SERVICE=sparkjava
IMAGE_NAME=dip-sparkjava
CONTAINER_PORT=8080
HOST_PORT=8080
HEALTH_PATH=/
HEALTH_EXPECT="Hello from Docker!"
# JVM startup is slower than the default 3s wait used for interpreted/static apps.
STARTUP_WAIT=4
