# Per-example pipeline configuration for the "wordpress-mysql" awesome-compose
# example.
#
# PREBUILT example: this entry ships no Dockerfile — it only wires together two
# upstream images. There is nothing to `docker compose build`, so PREBUILT_IMAGE
# names the exact registry reference the vendor compose file gives the target
# service, and pipeline/build.sh pulls and re-tags it as :original instead of
# building. Everything downstream (functional tests, Slim, SBOM, Grype,
# metrics, comparison) is unchanged. See docs/methodology.md §12.
EXAMPLE=wordpress-mysql
COMPOSE_FILE=vendor/awesome-compose/wordpress-mysql/compose.yaml
COMPOSE_SERVICE=wordpress
PREBUILT_IMAGE=wordpress:7.1.0-apache@sha256:5a93c470ae8220fddf71f6ebe3bc94e615ddc2ae4d9810f795b830fb11c41a17
IMAGE_NAME=dip-wordpress-mysql
CONTAINER_PORT=80
HOST_PORT=8109
HEALTH_PATH=/wp-admin/install.php
HEALTH_EXPECT="WordPress"
STARTUP_WAIT=20
COMPOSE_DEPS="db"

# The installer page is PHP; the stylesheet next to it is a static file served
# straight by Apache. Two different code paths through the same image, and the
# static tree (wp-admin/, wp-includes/) is exactly the kind of thing Slim drops
# when no probe ever requests it.
EXTRA_PROBE_PATHS="/wp-admin/css/install.min.css /wp-includes/css/dashicons.min.css"

# Slim-only: compose.yaml supplies these to the service itself; docker-slim
# starts its analysis container outside compose, so they are restated here.
APP_ENV="WORDPRESS_DB_HOST=db WORDPRESS_DB_USER=wordpress WORDPRESS_DB_PASSWORD=wordpress WORDPRESS_DB_NAME=wordpress"
