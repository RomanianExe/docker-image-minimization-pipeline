# Per-example pipeline configuration for the "react-nginx" awesome-compose example.
EXAMPLE=react-nginx
BUILD_CONTEXT=vendor/awesome-compose/react-nginx
# DOCKERFILE_TARGET intentionally empty: the Dockerfile's final (unnamed) stage
# (nginx:alpine serving the built React bundle) is the one compose.yaml actually
# builds (no `target:` set there either) — pipeline/build.sh omits --target when
# this is empty, so docker build uses the last stage.
DOCKERFILE_TARGET=
IMAGE_NAME=dip-react-nginx
CONTAINER_PORT=80
HOST_PORT=8080
HEALTH_PATH=/
HEALTH_EXPECT="React App"
