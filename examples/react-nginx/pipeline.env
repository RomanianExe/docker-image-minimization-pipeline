# Per-example pipeline configuration for the "react-nginx" awesome-compose example.
# The Dockerfile's final (unnamed) stage — nginx:alpine serving the built React
# bundle — is the one compose.yaml actually builds (it sets no `target:`), so
# `docker compose build` picks it up with no extra configuration.
EXAMPLE=react-nginx
COMPOSE_FILE=vendor/awesome-compose/react-nginx/compose.yaml
COMPOSE_SERVICE=frontend
IMAGE_NAME=dip-react-nginx
CONTAINER_PORT=80
HOST_PORT=8080
HEALTH_PATH=/
HEALTH_EXPECT="React App"
