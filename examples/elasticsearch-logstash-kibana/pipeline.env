# ============================================================================
# OUT OF SCOPE for this project's results — REACHED SLIM, NOT VALIDATED.
#
# The `original` stage passes and artifacts/elasticsearch-logstash-kibana/original/ holds a real
# baseline, but no validated slim image exists. Kept as evidence, not as
# pending work. Scope rationale: the plan's Stage 7 asks for "as many
# relevant examples as possible" and Stage 1 filters to those "that can be
# processed"; this entry has no Dockerfile, so it never enters Stage 2's
# `docker compose build` baseline. See docs/methodology.md 12.3.
#
# The environment blocker described below (the 7.16.1 bundled JDK crashing on
# cgroup v2) is SOLVED by the deliberate deviation to 7.17.28, which is applied
# in PREBUILT_IMAGE further down. What remains is a pipeline-side failure:
# COMPOSE_NETWORK was missing, so pipeline/slim.sh passed mint the compose
# default network name instead of this example's own `elastic`, and mint exited
# with `param.error status='unknown.network'`. COMPOSE_NETWORK=elastic is set
# below, but the run that would confirm it was never completed — hence
# "not validated" rather than a result. See docs/methodology.md 12.3.
# ============================================================================

# Per-example pipeline configuration for the "elasticsearch-logstash-kibana"
# awesome-compose example.
#
# PREBUILT example: no Dockerfile in the entry, so PREBUILT_IMAGE names the
# registry reference the vendor compose file gives the target service and
# pipeline/build.sh pulls and re-tags it instead of building. See
# docs/methodology.md §12.
#
# Target choice: kibana. The entry has three services and any of them could be
# called "the" image, so the choice follows the same rule used for
# prometheus-grafana — minimize the service where minimization has something to
# work on. Elasticsearch and Logstash are JVM servers whose behaviour is driven
# by classpath scanning and plugin discovery, the worst possible case for a
# tool that decides what to keep by watching one run. Kibana is a Node server
# plus a very large static bundle, which is the shape Slim handles well.
#
# Version deviation, deliberate and the only one of its kind in the set: the
# vendor file pins 7.16.1, and that build does not run on this host at all.
# Elasticsearch 7.16.1 ships a bundled JDK 17.0.1 whose cgroup v2 detection
# crashes before Elasticsearch even starts:
#
#   Exception in thread "main" java.lang.NullPointerException: Cannot invoke
#   "jdk.internal.platform.CgroupInfo.getMountPoint()" because "anyController"
#   is null
#     at java.base/jdk.internal.platform.cgroupv2.CgroupV2Subsystem.getInstance
#
# It is a JDK bug against a kernel five years newer than the image, not
# dependency drift — the tag is pinned, so nothing "moved"; the ground under it
# did. It cannot be worked around from outside the image (ES_JAVA_OPTS is read
# by the launcher that is already crashing, and --cgroupns=host does not help).
# 7.17.28, the last release of the same 7.x line, fixes it by passing
# -Des.cgroups.hierarchy.override=/ and starts cleanly here.
#
# This does change the artifact being measured, unlike the dependency-only pins
# elsewhere in this repo, so it is called out rather than buried: the result
# below is for Kibana 7.17.28, not 7.16.1.
#
# Logstash is not started: it only tails a sample nginx log into Elasticsearch
# and nothing in Kibana's functional test depends on it, so starting a second
# JVM would add minutes per stage for no measurement.
EXAMPLE=elasticsearch-logstash-kibana
COMPOSE_FILE=vendor/awesome-compose/elasticsearch-logstash-kibana/compose.yaml
COMPOSE_SERVICE=kibana
PREBUILT_IMAGE=kibana:7.17.28
IMAGE_NAME=dip-elasticsearch-logstash-kibana
CONTAINER_PORT=5601
HOST_PORT=8116
HEALTH_PATH=/api/status
# Kibana 7.x reports the LEGACY status shape (status.overall.state); the
# "level":"available" form only appears from 8.x on.
HEALTH_EXPECT='"state":"green"'
STARTUP_WAIT=120
COMPOSE_DEPS="elasticsearch"

# The vendor file puts both services on its own `elastic` network, not the
# compose default, so docker-slim has to be told which one to join.
COMPOSE_NETWORK=elastic

EXTRA_PROBE_PATHS="/app/home /api/settings /ui/favicons/favicon.svg"

# Slim-only: the Kibana image defaults to http://elasticsearch:9200, which is
# the service-name alias compose provides, but docker-slim's container is
# attached to the network by hand so the value is restated rather than assumed.
APP_ENV="ELASTICSEARCH_HOSTS=http://elasticsearch:9200"

# Kibana writes its optimizer cache and pid files under /usr/share/kibana/data
# during startup; without this they would be baked into the minimized image.
SLIM_MOUNTS="dip-slim-scratch-elasticsearch-logstash-kibana:/usr/share/kibana/data"
# Paired with SLIM_MOUNTS above: mint's --exclude-mounts does not actually
# keep a mounted volume's contents out of the output image (verified), so the
# same path is also excluded by pattern. Both the directory and its contents,
# because leftover empty directories carry the analysis run's ownership.
SLIM_EXCLUDE_PATTERNS="/usr/share/kibana/data /usr/share/kibana/data/* /usr/share/kibana/data/**"
SLIM_INCLUDE_PATHS="/usr/share/kibana/src/core/server/core_app/assets/favicons"
