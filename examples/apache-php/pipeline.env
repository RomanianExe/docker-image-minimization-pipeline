# Per-example pipeline configuration for the "apache-php" awesome-compose example.
EXAMPLE=apache-php
COMPOSE_FILE=vendor/awesome-compose/apache-php/compose.yaml
COMPOSE_SERVICE=web
IMAGE_NAME=dip-apache-php
CONTAINER_PORT=80
HOST_PORT=8080
HEALTH_PATH=/
HEALTH_EXPECT="Hello World!"

# NOTE: the vendored Dockerfile relies on a compose bind mount (./app ->
# /var/www/html) for dev use and does not COPY the app code into the image. This
# pipeline builds examples/apache-php/Dockerfile instead, which bakes
# app/index.php into the image, so it can be built and minimized standalone
# (see compose.override.yaml and that Dockerfile's own comment for details).
